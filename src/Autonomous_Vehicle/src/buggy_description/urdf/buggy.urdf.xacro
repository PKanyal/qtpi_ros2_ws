<?xml version="1.0"?>
<robot name="buggy" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Lidar yaw on the robot (radians): +174 deg, final mounting position
         (measured 2026-11-19, confirmed by a person walking in front). The
         launch files pass lidar_yaw:=..., so change the default there;
         this one is for standalone xacro / display.launch. -->
    <xacro:arg name="lidar_yaw" default="${radians(174)}"/>

    <xacro:include filename="$(find buggy_description)/urdf/common_properties.xacro"/>
    <xacro:include filename="$(find buggy_description)/urdf/mobile_base_buggy.xacro"/>

</robot>
