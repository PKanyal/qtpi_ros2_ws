<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
    Frame layout (must match the rest of the stack):

      odom -> base_link          published by encoder_odometry
      base_link (root)           on the ground, between the wheels
        ├─ base_footprint        same point (for tools that expect it)
        ├─ *_wheel_link          wheel axles, z = wheel_radius
        └─ laser                 lidar optical centre

    base_link must stay the root link: odometry already publishes
    odom -> base_link, and a TF frame can only have one parent.
    -->

    <xacro:property name="base_length" value="0.20"/>
    <xacro:property name="base_width" value="0.18"/>
    <xacro:property name="base_height" value="0.10"/>

    <xacro:property name="wheel_radius" value="0.04"/>
    <xacro:property name="wheel_width" value="0.03"/>

    <!-- Distance between left and right wheel centres (measured 0.25 m).
         Physical value only: odometry and the firmware use the larger
         EFFECTIVE skid-steer width 0.372 m from the spin test. -->
    <xacro:property name="wheel_track" value="0.25"/>

    <!-- Distance between front and rear axles (measured 0.17 m) -->
    <xacro:property name="wheel_base" value="0.17"/>

    <!-- Lidar (SLLIDAR A2M12) position relative to base_link.
         Same values the SLAM maps were made with. -->
    <xacro:property name="lidar_x" value="0.12"/>
    <xacro:property name="lidar_z" value="0.18"/>
    <xacro:property name="lidar_radius" value="0.04"/>
    <xacro:property name="lidar_height" value="0.06"/>

    <!-- Body sits on the axles -->
    <xacro:property name="body_z" value="${wheel_radius + base_height/2}"/>


    <link name="base_link">

        <visual>
            <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>

        <xacro:box_inertial
            m="6.0"
            x="${base_length}"
            y="${base_width}"
            z="${base_height}"
            o_xyz="0 0 ${body_z}"
            o_rpy="0 0 0"/>

    </link>


    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <xacro:macro name="wheel" params="name x y">

        <link name="${name}_wheel_link">

            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>
                <material name="gray"/>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>
            </collision>

            <xacro:cylinder_inertial
                m="0.5"
                r="${wheel_radius}"
                l="${wheel_width}"
                o_xyz="0 0 0"
                o_rpy="${pi/2} 0 0"/>

        </link>

        <joint name="${name}_wheel_joint"
               type="continuous">

            <parent link="base_link"/>
            <child link="${name}_wheel_link"/>

            <origin xyz="${x} ${y} ${wheel_radius}"/>

            <axis xyz="0 1 0"/>

        </joint>

    </xacro:macro>


    <xacro:wheel
        name="front_left"
        x="${wheel_base/2}"
        y="${wheel_track/2}"/>

    <xacro:wheel
        name="front_right"
        x="${wheel_base/2}"
        y="${-wheel_track/2}"/>

    <xacro:wheel
        name="rear_left"
        x="${-wheel_base/2}"
        y="${wheel_track/2}"/>

    <xacro:wheel
        name="rear_right"
        x="${-wheel_base/2}"
        y="${-wheel_track/2}"/>


    <link name="laser">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}"
                          length="${lidar_height}"/>
            </geometry>
            <material name="green"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}"
                          length="${lidar_height}"/>
            </geometry>
        </collision>

        <xacro:cylinder_inertial
            m="0.30"
            r="${lidar_radius}"
            l="${lidar_height}"
            o_xyz="0 0 0"
            o_rpy="0 0 0"/>

    </link>

    <joint name="lidar_joint"
           type="fixed">

        <parent link="base_link"/>
        <child link="laser"/>

        <!-- yaw from the lidar_yaw xacro arg (see buggy.urdf.xacro) -->
        <origin xyz="${lidar_x} 0 ${lidar_z}"
                rpy="0 0 $(arg lidar_yaw)"/>

    </joint>

</robot>
