<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS inside the RViz container: DDS stays on loopback; only the
  Zenoh bridge talks to the Pi. Loopback has no multicast in containers,
  so discovery uses unicast to 127.0.0.1 instead.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>20</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="127.0.0.1"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
