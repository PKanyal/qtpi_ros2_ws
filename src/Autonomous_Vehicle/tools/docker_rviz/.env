# How the container reaches the Pi's Zenoh bridge (port 7447).
# Default: through an SSH tunnel that start.sh opens on the Mac, because
# macOS can block local IPv4 connections (ssh to 172.20.10.5 failed).
PI_ADDR=host.docker.internal

# SSH target start.sh uses for the tunnel (qtpi.local works over IPv6).
PI_SSH=qtpi@qtpi.local

# Without the tunnel, set PI_ADDR to the Pi's IPv4 instead, for example:
# PI_ADDR=172.20.10.5
